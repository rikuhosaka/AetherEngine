{
  "version": 3,

  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Ninja + Clang-cl (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Ninja + Clang-cl (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs2026-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MAKE_PROGRAM": "$penv{VSINSTALLDIR}Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs2026",
      "displayName": "VS 2026 + MSVC (Debug)",
      "inherits": "vs2026-base",
      "binaryDir": "${sourceDir}/build/vs2026",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vs2026-release",
      "displayName": "VS 2026 + MSVC (Release)",
      "inherits": "vs2026-base",
      "binaryDir": "${sourceDir}/build/vs2026-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build (Ninja Debug)",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Build (Ninja Release)",
      "configurePreset": "release"
    },
    {
      "name": "vs2022-debug",
      "displayName": "Build (VS Debug)",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "displayName": "Build (VS Release)",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2026-debug",
      "displayName": "Build (VS 2026 Debug)",
      "configurePreset": "vs2026",
      "targets": ["Runtime"]
    },
    {
      "name": "vs2026-release",
      "displayName": "Build (VS 2026 Release)",
      "configurePreset": "vs2026-release",
      "targets": ["Runtime"]
    }
  ]
}
