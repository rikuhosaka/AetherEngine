CompileFlags:
  CompilationDatabase: build/debug
  Add:
    - -std=c++20
    - -IC:/AetherEngine/ThirdParty/ImGui/imgui
    - -IC:/AetherEngine/ThirdParty/ImGui/imgui/backends
  Remove: [/Yu*, /Fp*]

Diagnostics:
  Suppress: ["-Wunused-parameter"]

Index:
  Background: Build

Completion:
  AllScopes: true

InlayHints:
  Enabled: true

Hover:
  ShowAKA: true